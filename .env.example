# Copy to .env and fill in. .env is gitignored; never commit real keys.
#
# All model calls (agents, oracle judges, monitors, auditor) go through a LiteLLM proxy
# (https://docs.litellm.ai/docs/simple_proxy) that serves both the OpenAI and the Anthropic Messages
# API. Model ids in the code are proxy route names, e.g. anthropic/claude-opus-4-8,
# openai/gpt-5.6-luna, fireworks_ai/glm-5p3; configure your proxy to expose the ones you use.

# --- Proxy used by the local scripts (oracle judges, probe builders, monitors) ---
LITELLM_BASE_URL=https://your-litellm-proxy.example.com/v1
LITELLM_API_KEY=sk-...

# --- Proxy used from inside Modal sandboxes (agents + scorers). Must be publicly routable. ---
# Defaults to LITELLM_BASE_URL when unset. Give it without /v1.
PUB_LITELLM_BASE_URL=https://your-litellm-proxy.example.com
# One or more keys. Runs rotate over them (--key N picks the ring offset), so budget-capped keys
# spread a sweep's spend. Numbering may have gaps.
PUB_LITELLM_API_KEY1=sk-...
# PUB_LITELLM_API_KEY2=sk-...

# --- Hugging Face (successor weights; gated datasets: sorry-bench, and GPQA for row23) ---
HF_TOKEN=hf_...
